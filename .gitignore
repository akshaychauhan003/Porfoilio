# ════════════════════════════════════════════════════════════════
# GITIGNORE FOR PORTFOLIO REPOSITORY
# ════════════════════════════════════════════════════════════════

# ── OS & IDE Artefacts ──
.DS_Store
/.DS_Store
.vscode/
/.vscode/
.idea/

# ── Build & Dependency Directories ──
node_modules/
dist/
.gradle/
assets/images/raw_originals/

# ── All Android APK Binaries (Globally Excluded) ──
*.apk
**/*.apk

# ── Private Database Credentials & Secret Configs ──
# (Note: Supabase anon key is safe for client-side use as it is protected by Postgres RLS)
.env
.env.*
*.env

# ── Private Android App Project (Akshay Console Native Code) ──
android-app/

# ── Private Admin Console Dashboard ──
dashboard/
